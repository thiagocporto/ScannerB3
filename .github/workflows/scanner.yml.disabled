name: Scanner Diario B3

on:
  schedule:
    # Roda de segunda a sexta às 21:30 UTC (18:30 no horário de Brasília)
    - cron: '30 21 * * 1-5'
  workflow_dispatch: # Permite rodar manualmente pelo botão

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  analise_e_deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar código do repositório
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - name: Instalar dependências
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Executar Pipeline do Scanner
        run: python main.py

     - name: Commit e push dos dados atualizados
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add index.html oportunidades_hoje.json scanner_fechamento.csv
          git commit -m "Auto-update: Relatório B3 [skip ci]" || exit 0
          git pull --rebase origin main
          git push origin main

      - name: Configurar GitHub Pages
        uses: actions/configure-pages@v4

      - name: Fazer upload do artefato do site
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'

      - name: Deploy para GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
